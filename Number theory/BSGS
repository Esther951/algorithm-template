ll qpow(ll a, ll b, ll mod)
{
    ll res = 1;
    a %= mod;
    while (b)
    {
        if (b & 1)
            res = res * a % mod;
        a = a * a % mod;
        b >>= 1;
    }
    return res;
}

ll BSGS(ll a, ll b, ll p)
{
    if (b == 1)
    {
        return 0;
    }

    ll m = ceil(sqrt(p));
    unordered_map<ll, ll> mp;

    ll cur = 1;
    for (ll j = 0; j < m; j++)
    {
        if (!mp.count(cur))
        {
            mp[cur] = j;
        }
        cur = cur * a % p;
    }

    ll inv = qpow(qpow(a, m, p), p - 2, p);

    cur = b;
    for (ll i = 0; i <= m; i++)
    {
        if (mp.count(cur))
        {
            ll ans = i * m + mp[cur];
            if (qpow(a, ans, p) == b)
            {
                return ans;
            }
        }
        cur = cur * inv % p;
    }

    return -1;
}
